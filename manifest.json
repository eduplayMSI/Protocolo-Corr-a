{
"id": "/Protocolo-Corr-a/",
"name": "Protocolo Corrêa - Avaliação de Acessibilidade",
"short_name": "Protocolo Corrêa",
"description": "Ferramenta digital para avaliação de acessibilidade em espaços de recreação escolar.",
"lang": "pt-BR",
"dir": "ltr",

"start_url": "./",
"scope": "./",
"scope_extensions": [
{
"origin": "https://eduplaymsi.github.io"
}
],

"display": "standalone",
"display_override": [
"window-controls-overlay",
"standalone",
"minimal-ui",
"browser"
],

"orientation": "portrait",

"theme_color": "#1a5f7a",
"background_color": "#ffffff",

"categories": [
"education",
"productivity",
"research",
"utilities"
],

"icons": [
{
"src": "./icons/icon-72.png",
"sizes": "72x72",
"type": "image/png"
},
{
"src": "./icons/icon-96.png",
"sizes": "96x96",
"type": "image/png"
},
{
"src": "./icons/icon-128.png",
"sizes": "128x128",
"type": "image/png"
},
{
"src": "./icons/icon-144.png",
"sizes": "144x144",
"type": "image/png"
},
{
"src": "./icons/icon-152.png",
"sizes": "152x152",
"type": "image/png"
},
{
"src": "./icons/icon-192.png",
"sizes": "192x192",
"type": "image/png",
"purpose": "any"
},
{
"src": "./icons/icon-384.png",
"sizes": "384x384",
"type": "image/png",
"purpose": "any"
},
{
"src": "./icons/icon-512.png",
"sizes": "512x512",
"type": "image/png",
"purpose": "any"
},
{
"src": "./icons/icon-512-maskable.png",
"sizes": "512x512",
"type": "image/png",
"purpose": "maskable"
}
],

"screenshots": [
{
"src": "./screenshots/home-desktop.png",
"sizes": "1280x720",
"type": "image/png",
"form_factor": "wide",
"label": "Tela principal da avaliação"
},
{
"src": "./screenshots/home-mobile.png",
"sizes": "720x1280",
"type": "image/png",
"label": "Versão móvel da aplicação"
}
],

"shortcuts": [
{
"name": "Nova Avaliação",
"short_name": "Avaliar",
"description": "Iniciar uma nova avaliação",
"url": "./?action=new",
"icons": [
{
"src": "./icons/icon-192.png",
"sizes": "192x192"
}
]
},
{
"name": "Relatórios",
"short_name": "Relatórios",
"description": "Visualizar relatórios gerados",
"url": "./?action=reports",
"icons": [
{
"src": "./icons/icon-192.png",
"sizes": "192x192"
}
]
}
],

"share_target": {
"action": "./share",
"method": "POST",
"enctype": "multipart/form-data",
"params": {
"title": "title",
"text": "text",
"url": "url"
}
},

"launch_handler": {
"client_mode": [
"focus-existing",
"auto"
]
},

"protocol_handlers": [
{
"protocol": "web+protocolo-correa",
"url": "./?protocol=%s"
}
],

"file_handlers": [
{
"action": "./import",
"accept": {
"application/json": [
".json"
]
}
}
],

"prefer_related_applications": false,

"related_applications": [],

"edge_side_panel": {
"preferred_width": 420
},

"widgets": [
{
"name": "Protocolo Corrêa Widget",
"short_name": "Corrêa",
"description": "Acesso rápido às avaliações."
}
],

"note_taking": {
"new_note_url": "./?action=new-note"
},

"iarc_rating_id": ""
}
